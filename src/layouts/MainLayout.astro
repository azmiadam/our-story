---
import "../styles/global.css";
import { MusicPlayer } from "../components/common/MusicPlayer";

interface Props {
  title: string;
  description?: string;
}

const { title, description = "A special birthday storytelling journey." } =
  Astro.props;
---

<!doctype html>
<html lang="id" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap"
      rel="stylesheet"
    />

    <title>{title}</title>
  </head>
  <body
    class="bg-neutral-50 text-neutral-900 overflow-x-hidden selection:bg-primary-200 selection:text-primary-900">
    <slot />

    <MusicPlayer client:load src="/audio/instrument1.mp3" />
  </body>
</html>
